# Server-only secrets. Never prefix these with VITE_.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
DATABASE_ENVIRONMENT=test
SINGLE_USER_PASSWORD_HASH=scrypt$replace-with-base64url-salt$replace-with-base64url-hash
SINGLE_USER_SESSION_SECRET=replace-with-at-least-32-random-characters
SINGLE_USER_ID=single-user

# Comma-separated exact origins accepted for state-changing requests.
# Add the Vercel Preview and Production origins in their respective environments.
APP_ORIGINS=http://localhost:3000,http://localhost:5173
